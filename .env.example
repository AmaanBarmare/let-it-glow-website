# Resend API key for the contact form
# Sign up at https://resend.com and create an API key
RESEND_API_KEY=

# Email address that receives quote requests
CONTACT_TO_EMAIL=info@letitglowholidaylighting.com

# Verified sender (must be a domain you've verified in Resend, or "onboarding@resend.dev" while testing)
CONTACT_FROM_EMAIL=onboarding@resend.dev
